# Placeholder template. Copy to .env and fill in locally.
# Never commit .env. The LLM settings are only used with --llm. EMBEDDING_MODEL is only used
# with --rag semantic. Nothing here is needed for the default run or for --rag lexical.

APP_ENV=development
LOG_LEVEL=INFO

# Local LLM through Ollama. Resume text is sent to OLLAMA_BASE_URL, so keep it on this computer.
LLM_PROVIDER=ollama
# The name of a model you downloaded. Run "ollama list" to see it. No default is provided.
# Do not use a name ending in -cloud: cloud models run on remote servers.
LLM_MODEL=your_model_name_here
OLLAMA_BASE_URL=http://localhost:11434
# Seconds to wait for each reply. The first call loads the model, so raise this on slow machines.
LLM_TIMEOUT_SECONDS=30
# Extra attempts after a timeout, a lost connection or a server error. 0 to 5.
LLM_MAX_RETRIES=2
# Upper limit on the length of the model's reply, in tokens.
LLM_MAX_OUTPUT_TOKENS=2048
# Not used by the Ollama provider. Leave it empty.
LLM_API_KEY=

# Embedding model for --rag semantic. Download one with "ollama pull <name>" and use the exact
# name from "ollama list". No default is provided. Do not use a name ending in -cloud.
# Resume text is sent to OLLAMA_BASE_URL. The server address, timeout and retries above also
# apply to embeddings.
EMBEDDING_MODEL=your_embedding_model_here
# Optional. Some embedding models expect a short label in front of each text. For
# nomic-embed-text use search_query: and search_document: . Leave both empty if unsure.
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=

# These two are read into the settings but no code uses them yet. There is no vector database
# (embeddings are kept in memory for one run) and the resume path is given with --resume.
CHROMA_PERSIST_DIR=data/chroma
INCOMING_RESUME_DIR=data/incoming